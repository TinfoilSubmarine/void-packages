# Template file for 'OpenLP'
pkgname=OpenLP
version=4.0a2
revision=1
build_style=python3-pep517
hostmakedepends="hatchling hatch-vcs qt6-tools"
depends="python3-alembic python3-BeautifulSoup4 python3-chardet python3-distro
 python3-Flask python3-Flask-Cors python3-lxml python3-Mako python3-Pillow
 python3-platformdirs python3-PyICU python3-pyside6 python3-pyside6-gui
 python3-pyside6-webengine python3-pyside6-multimedia python3-pyside6-pdf
 python3-qrcode python3-QtAwesome python3-requests python3-SQLAlchemy
 python3-waitress python3-websocket-client python3-websockets"
checkdepends="python3-pytest python3-pytest-qt python3-pyside6-test ${depends}"
short_desc="Free Worship Presentation Software for your Church"
maintainer="Piotr Wójcik <chocimier@tlen.pl>"
license="GPL-3.0-or-later"
homepage="https://openlp.org/"
distfiles="https://gitlab.com/openlp/openlp/-/archive/${version}/openlp-${version}.tar.gz"
checksum=98ed5e959ab27275cb0de58464db07fad428b630ae9d0658b45ceb7305db4560

export SETUPTOOLS_SCM_PRETEND_VERSION=${version}

post_install() {
	vmkdir usr/share/openlp/i18n
	cd resources/i18n
	for i in *.ts; do
		/usr/lib/qt6/bin/lconvert -i "${i}" -o "${DESTDIR}/usr/share/openlp/i18n/${i%ts}qm"
	done

	cd ../images
	for size in 16 32 48 64 128 256; do
		vinstall openlp-logo-${size}x${size}.png 644 \
			usr/share/icons/hicolor/${size}x${size}/apps openlp.png
	done
		vinstall openlp.svg 644 usr/share/icons/hicolor/scalable/apps

	cd ..

	vinstall openlp.desktop 644 usr/share/applications
	vinstall openlp.xml 644 usr/share/mime/packages
}
